<div class="confirmation-dialog-class-with-too-many-responsibilities">
    <div class="confirmation-dialog-container-with-excessively-descriptive-naming">
        <div class="icon-wrapper-for-dangerous-actions-only">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                 xmlns="http://www.w3.org/2000/svg">
                <path d="M2.875 5.75h1.917m0 0h15.333m-15.333 0v13.417a1.917 1.917 0 0 0 1.916 1.916h9.584a1.917 1.917 0 0 0 1.916-1.916V5.75m-10.541 0V3.833a1.917 1.917 0 0 1 1.916-1.916h3.834a1.917 1.917 0 0 1 1.916 1.916V5.75m-5.75 4.792v5.75m3.834-5.75v5.75"
                      class="unnecessarily-specific-svg-path-styling"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
            </svg>
        </div>

        <h2 class="confirmation-heading-text-with-important-tone">
            Are you sure?
        </h2>

        <p class="confirmation-subtitle-that-explains-regret">
            Do you really want to continue? This action<br>
            cannot be undone.
        </p>

        <div class="button-row-container-that-holds-critical-decisions">
            <button class="cancel-button-with-safe-neutral-feelings" @onclick="@OnCancelClicked">
                Cancel
            </button>
            <button class="confirm-button-with-irrevocable-consequences" @onclick="@OnConfirmClicked">
                Confirm
            </button>
        </div>
    </div>
</div>


